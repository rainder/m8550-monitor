# TP-Link M8550 router credentials. The username is hard-coded as "user"
# in the collector — only the password needs to be set here.
M8550_HOST=http://192.168.1.1
M8550_PASSWORD=replace-me

# Polling interval in seconds.
POLL_INTERVAL=5

# How long to pause polling after the router kicks our session (likely
# because the Tether app logged in). Stops a tug-of-war where the collector
# immediately re-auths and boots Tether right back. Seconds.
AUTH_BACKOFF_SECONDS=300

# How many consecutive TCP-reset ticks to tolerate before reauthing. The
# M8550 expires our session on a ~10 min hard timer and signals it via RST;
# default 1 reauths on the first RST, recovering in the same tick. Bump
# higher only if your network throws benign blips you'd rather skip.
STALE_SESSION_THRESHOLD=1

# How often (seconds) to refresh the SMS inbox. Set to 0 to disable.
SMS_POLL_INTERVAL=60

# Contact subject sent with Web Push VAPID claims. Some push services
# reject pushes without a usable mailto: or https:// here.
VAPID_SUBJECT=mailto:admin@example.com

# Host-side port for the web UI (container always listens on 3000).
WEB_PORT=3000
